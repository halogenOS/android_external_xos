+src, out = sys.argv[1:]
+with open(src) as f, open(out, "w") as o:
+    o.write(f.read())
+`)
+	writeFile(t, filepath.Join(dir, "base/foo.cc"), "foo.cc")
+	writeFile(t, filepath.Join(dir, "base/foo.h"), "foo.h")
+	writeFile(t, filepath.Join(dir, "base/bar.in"), "bar.in")
+	// need to escape ":" (eps. on windows)
+	out := strings.ReplaceAll(outdir, ":", "$:")
+	writeFile(t, filepath.Join(dir, "out/siso/build.ninja"), fmt.Sprintf(`
+builddir = %[1]s
+
+rule cc
+  command = python3 ../../tools/cc.py ${out} ${out}.d ${in}
+  deps = gcc
+  depfile = ${out}.d
+
+rule cp
+  command = python3 ../../tools/cp.py ${in} ${out}
+
+build %[1]s/obj/foo.o: cc ../../base/foo.cc
+build %[1]s/gen/bar.txt: cp ../../base/bar.in
+
+build all: phony %[1]s/obj/foo.o %[1]s/gen/bar.txt
+
+build build.ninja: phony
+`, out))
+	err := os.MkdirAll(filepath.Join(outdir, "obj"), 0755)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = os.MkdirAll(filepath.Join(outdir, "gen"), 0755)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	t.Logf("-- first build")
+	stats, err := runNinjaTest(t)
+	if err != nil {
+		t.Fatalf("ninja err: %v", err)
+	}
+	if stats.Done != stats.Total || stats.Local != 2 || stats.Total != 3 {
+		t.Errorf("done=%d total=%d local=%d; want done=total=3 local=2: %#v", stats.Done, stats.Total, stats.Local, stats)
+	}
+
+	t.Logf("-- check deps log")
+	func() {
+		depsLog, cleanup := openDepsLog(ctx, t, dir)
+		defer cleanup()
+		fooObj := outdir + "/obj/foo.o"
+		deps, mtime, err := depsLog.RetrievePaths(ctx, fooObj)
+		if err != nil {
+			t.Fatalf("depsLog.RetrievePaths(ctx, %q)=%v, %v, %v; want nil err", fooObj, deps, mtime, err)
+		}
+		want := []string{"../../base/foo.cc", "../../base/foo.h"}
+		if !slices.Equal(deps, want) {
+			t.Errorf("deps for %s=%q; want=%q", fooObj, deps, want)
+		}
+	}()
+
+	t.Logf("-- confirm no-op")
+	stats, err = runNinjaTest(t)
+	if err != nil {
+		t.Fatalf("ninja err: %v", err)
+	}
+	if stats.Done != stats.Total || stats.Local != 0 || stats.Skipped != 3 || stats.Total != 3 {
+		t.Errorf("done=%d total=%d skipped=%d local=%d; want done=total=skipped=3 local=0: %#v", stats.Done, stats.Total, stats.Skipped, stats.Local, stats)
+	}
+
+	fooObj := outdir + "/obj/foo.o"
+	barTxt := outdir + "/gen/bar.txt"
+	fooMtime := mtime(t, fooObj)
+	barMtime := mtime(t, barTxt)
+	touchFile(t, dir, "base/foo.h")
+	t.Logf("-- second build")
+	stats, err = runNinjaTest(t)
+	if err != nil {
+		t.Fatalf("ninja err: %v", err)
+	}
+	if stats.Done != stats.Total || stats.Local != 1 || stats.Skipped != 2 || stats.Total != 3 {
+		t.Errorf("done=%d total=%d skipped=%d local=%d; want done=total=3 skipped=2 local=1: %#v", stats.Done, stats.Total, stats.Skipped, stats.Local, stats)
+	}
+	if got := mtime(t, fooObj); got.Equal(fooMtime) {
+		t.Errorf("%s not rebuilt: mtime=%v", fooObj, got)
+	}
+	if got := mtime(t, barTxt); !got.Equal(barMtime) {
+		t.Errorf("%s rebuilt: mtime=%v want=%v", barTxt, got, barMtime)
+	}
+}
