+
+// absFromExecRoot converts exec root relative to absolute path.
+// It keeps absolute path as is, as FromWD keeps absolute path
+// for out of exec root.
+func absFromExecRoot(execRoot, path string) string {
+	if filepath.IsAbs(path) {
+		return path
+	}
+	return filepath.Join(execRoot, path)
+}
