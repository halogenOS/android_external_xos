+// Test Update records an output given as absolute path out of exec root
+// (e.g. absolute build dir) at that path, not under exec root.
+func TestUpdate_FromLocal_OutOfExecRoot(t *testing.T) {
+	ctx := t.Context()
+	base := t.TempDir()
+	base, err := filepath.EvalSymlinks(base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	execRoot := filepath.Join(base, "src")
+	err = os.MkdirAll(execRoot, 0755)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	opt := hashfs.Option{}
+	hfs, err := hashfs.New(ctx, opt)
+	if err != nil {
+		t.Fatalf("New=%v", err)
+	}
+	defer func() {
+		if hfs == nil {
+			return
+		}
+		err := hfs.Close(ctx)
+		if err != nil {
+			t.Fatalf("hfs.Close=%v", err)
+		}
+	}()
+
+	fname := filepath.ToSlash(filepath.Join(base, "out/gen/foo.stamp"))
+	setupFiles(t, base, map[string]string{
+		"out/gen/foo.stamp": "0",
+	})
+	pre := hfs.RetrieveUpdateEntries(ctx, execRoot, []string{fname})
+	if len(pre) != 1 {
+		t.Fatalf("RetrieveUpdateEntries(ctx, %q, {%q})=%d entries; want 1", execRoot, fname, len(pre))
+	}
+
+	time.Sleep(1 * time.Microsecond)
+	setupFiles(t, base, map[string]string{
+		"out/gen/foo.stamp": "1",
+	})
+	h := sha256.New()
+	h.Write([]byte("command line"))
+	cmdhash := h.Sum(nil)
+	post := hfs.RetrieveUpdateEntriesFromLocal(ctx, execRoot, []string{fname})
+	now := time.Now()
+	entries := computeUpdateEntries(pre, post, false, now, cmdhash)
+	err = hfs.Update(ctx, execRoot, entries)
+	if err != nil {
+		t.Errorf("Update(ctx, %q, {%q}, %v, cmdhash)=%v; want nil err", execRoot, fname, now, err)
+	}
+
+	fi, err := hfs.Stat(ctx, execRoot, fname)
+	if err != nil {
+		t.Fatalf("Stat(ctx, %q, %q)=_, %v; want nil err", execRoot, fname, err)
+	}
+	if !bytes.Equal(fi.CmdHash(), cmdhash) {
+		t.Errorf("fi.CmdHash()=%q want=%q", base64.StdEncoding.EncodeToString(fi.CmdHash()), base64.StdEncoding.EncodeToString(cmdhash))
+	}
+	m := hashfs.StateMap(hfs.State(ctx))
+	hfs = nil
+	wrongname := filepath.ToSlash(filepath.Join(execRoot, fname))
+	if _, ok := m[wrongname]; ok {
+		t.Errorf("unexpected entry for %s", wrongname)
+	}
+	e, ok := m[fname]
+	if !ok {
+		var keys []string
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		t.Fatalf("entry for %s not found: %q", fname, keys)
+	}
+	if e.Id.ModTime != now.UnixNano() {
+		t.Errorf("entry modtime=%d want=%d", e.Id.ModTime, now.UnixNano())
+	}
+	if !bytes.Equal(e.CmdHash, cmdhash) {
+		t.Errorf("entry cmdhash=%q want=%q", base64.StdEncoding.EncodeToString(e.CmdHash), base64.StdEncoding.EncodeToString(cmdhash))
+	}
+	lfi, err := os.Lstat(fname)
+	if err != nil {
+		t.Fatalf("lstat(%q)=%v; want nil", fname, err)
+	}
+	if e.Id.ModTime != lfi.ModTime().UnixNano() {
+		t.Errorf("entry modtime=%d lfi=%d", e.Id.ModTime, lfi.ModTime().UnixNano())
+	}
+}
