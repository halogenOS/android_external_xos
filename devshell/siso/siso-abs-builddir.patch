+// wrapperStepDef is a step def whose rule sets use_remote_exec_wrapper.
+type wrapperStepDef struct {
+	fakeStepDef
+}
+
+func (f wrapperStepDef) Binding(b string) string {
+	if b == "use_remote_exec_wrapper" {
+		return "rewrapper"
+	}
+	return f.fakeStepDef.Binding(b)
+}
+
+// Test mayRunRemote is true only for step that siso may run remotely,
+// so checkDeps keeps refusing absolute path dep for such step.
+func TestMayRunRemote(t *testing.T) {
+	ctx := t.Context()
+	platform := map[string]string{"OSFamily": "Linux"}
+	for _, tc := range []struct {
+		name string
+		b    *Builder
+		def  StepDef
+		cmd  *execute.Cmd
+		want bool
+	}{
+		{
+			name: "remote exec wrapper",
+			b:    &Builder{},
+			def:  wrapperStepDef{},
+			cmd:  &execute.Cmd{},
+			want: true,
+		},
+		{
+			name: "reproxy",
+			b:    &Builder{reproxyExec: reproxyexec.New(ctx, "localhost:1234")},
+			def:  fakeStepDef{},
+			cmd:  &execute.Cmd{REProxyConfig: &execute.REProxyConfig{}},
+			want: true,
+		},
+		{
+			name: "remote exec",
+			b:    &Builder{remoteExec: remoteexec.New(ctx, nil)},
+			def:  fakeStepDef{},
+			cmd:  &execute.Cmd{Platform: platform},
+			want: true,
+		},
+		{
+			name: "platform without remote exec",
+			b:    &Builder{},
+			def:  fakeStepDef{},
+			cmd:  &execute.Cmd{Platform: platform},
+			want: false,
+		},
+		{
+			name: "platform with reproxy disabled",
+			b:    &Builder{reproxyExec: reproxyexec.New(ctx, "")},
+			def:  fakeStepDef{},
+			cmd: &execute.Cmd{
+				Platform:      platform,
+				REProxyConfig: &execute.REProxyConfig{},
+			},
+			want: false,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			step := &Step{def: tc.def, cmd: tc.cmd}
+			got := tc.b.mayRunRemote(step)
+			if got != tc.want {
+				t.Errorf("mayRunRemote=%t; want %t", got, tc.want)
+			}
+		})
+	}
+}
+
+// Test checkDeps refuses absolute path dep of step that may run
