+	step := &Step{
+		def: fakeStepDef{},
+		cmd: &execute.Cmd{
+			Outputs:  []string{"out/siso/obj/foo.o"},
+			Platform: map[string]string{"OSFamily": "Linux"},
+		},
+	}
+	dep := filepath.Join(t.TempDir(), "gen/gen.h")
+	err = checkDeps(ctx, b, step, []string{dep})
+	if !errors.Is(err, errNotRelocatable) {
+		t.Errorf("checkDeps(ctx, b, step, {%q})=%v; want %v", dep, err, errNotRelocatable)
+	}
+}
