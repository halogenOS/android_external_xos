+// mayRunRemote reports whether the step may run remotely: by remote exec,
+// by reproxy, or by remote exec wrapper.
+func (b *Builder) mayRunRemote(step *Step) bool {
+	if step.def.Binding("use_remote_exec_wrapper") != "" {
+		return true
+	}
+	if b.reproxyExec != nil && b.allowREProxy(step) {
+		return true
+	}
+	return b.allowRemote(step)
+}
