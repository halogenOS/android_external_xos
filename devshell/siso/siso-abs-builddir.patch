+// Test local step of remote rule without remote exec accepts
+// absolute path dep out of exec root, and records it in deps log.
+func TestBuild_Local_AbsBuildDirGeneratedHeader(t *testing.T) {
+	if !runInSubProcess(t) {
+		return
+	}
+	ctx := t.Context()
+	topdir := tempDir(t)
+
+	dir := filepath.Join(topdir, "src")
+	outdir := filepath.ToSlash(filepath.Join(topdir, "out"))
+
+	runNinjaTest := func(t *testing.T) (build.Stats, error) {
+		t.Helper()
+		opt, graph, cleanup := setupBuild(ctx, t, dir, hashfs.Option{
+			StateFile: ".siso_fs_state",
+		})
+		defer cleanup()
+		return ninjabuild.Run(ctx, graph, opt, nil, ninjabuild.RunNinjaOpts{})
+	}
+
+	writeFile := func(t *testing.T, fname, content string) {
+		t.Helper()
+		err := os.MkdirAll(filepath.Dir(fname), 0755)
+		if err != nil {
+			t.Fatal(err)
+		}
+		err = os.WriteFile(fname, []byte(content), 0644)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	mtime := func(t *testing.T, fname string) time.Time {
+		t.Helper()
+		fi, err := os.Stat(fname)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return fi.ModTime()
+	}
+
+	// "remote": True gives the step a platform, even with no
+	// platforms and no remote exec configured.
+	writeFile(t, filepath.Join(dir, "build/config/siso/main.star"), `
+load("@builtin//encoding.star", "json")
+load("@builtin//struct.star", "module")
+
+def init(ctx):
+    step_config = {
+        "platforms": {},
+        "rules": [
+            {
+                "name": "cc",
+                "action": "cc",
+                "remote": True,
+            },
+        ],
+    }
+    return module(
+        "config",
+        step_config = json.encode(step_config),
+        filegroups = {},
+        handlers = {},
+    )
+`)
+	writeFile(t, filepath.Join(dir, "tools/cc.py"), `
+import sys
+out, depfile, src = sys.argv[1:4]
+hdrs = sys.argv[4:]
+with open(out, "w") as o:
+    for f in [src] + hdrs:
+        with open(f) as i:
+            o.write(i.read())
+with open(depfile, "w") as d:
+    d.write(out + ": " + " ".join([src] + hdrs) + "\n")
+`)
+	writeFile(t, filepath.Join(dir, "tools/cp.py"), `
+import sys
+src, out = sys.argv[1:]
+with open(src) as f, open(out, "w") as o:
+    o.write(f.read())
+`)
+	writeFile(t, filepath.Join(dir, "base/foo.cc"), "foo.cc")
+	writeFile(t, filepath.Join(dir, "base/bar.cc"), "bar.cc")
+	writeFile(t, filepath.Join(dir, "base/gen.h.in"), "gen.h")
+	// need to escape ":" (eps. on windows)
+	out := strings.ReplaceAll(outdir, ":", "$:")
+	writeFile(t, filepath.Join(dir, "out/siso/build.ninja"), fmt.Sprintf(`
+builddir = %[1]s
+
+rule gen
+  command = python3 ../../tools/cp.py ${in} ${out}
+
+rule cc
+  command = python3 ../../tools/cc.py ${out} ${out}.d ${in} ${hdrs}
+  deps = gcc
+  depfile = ${out}.d
+
+build %[1]s/gen/gen.h: gen ../../base/gen.h.in
+build %[1]s/obj/foo.o: cc ../../base/foo.cc || %[1]s/gen/gen.h
+  hdrs = %[1]s/gen/gen.h
+build %[1]s/obj/bar.o: cc ../../base/bar.cc || %[1]s/gen/gen.h
+
+build all: phony %[1]s/obj/foo.o %[1]s/obj/bar.o
+
+build build.ninja: phony
+`, out))
+	for _, d := range []string{"obj", "gen"} {
+		err := os.MkdirAll(filepath.Join(outdir, d), 0755)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	t.Logf("-- first build")
+	stats, err := runNinjaTest(t)
+	if err != nil {
+		t.Fatalf("ninja err: %v", err)
+	}
+	if stats.Done != stats.Total || stats.Local != 3 || stats.Total != 4 {
+		t.Errorf("done=%d total=%d local=%d; want done=total=4 local=3: %#v", stats.Done, stats.Total, stats.Local, stats)
+	}
+
+	t.Logf("-- check deps log")
+	func() {
+		depsLog, cleanup := openDepsLog(ctx, t, dir)
+		defer cleanup()
+		fooObj := outdir + "/obj/foo.o"
+		deps, mtime, err := depsLog.RetrievePaths(ctx, fooObj)
+		if err != nil {
+			t.Fatalf("depsLog.RetrievePaths(ctx, %q)=%v, %v, %v; want nil err", fooObj, deps, mtime, err)
+		}
+		want := []string{"../../base/foo.cc", outdir + "/gen/gen.h"}
+		if !slices.Equal(deps, want) {
+			t.Errorf("deps for %s=%q; want=%q", fooObj, deps, want)
+		}
+	}()
+
+	t.Logf("-- confirm no-op")
+	stats, err = runNinjaTest(t)
+	if err != nil {
+		t.Fatalf("ninja err: %v", err)
+	}
+	if stats.Done != stats.Total || stats.Local != 0 || stats.Skipped != 4 || stats.Total != 4 {
+		t.Errorf("done=%d total=%d skipped=%d local=%d; want done=total=skipped=4 local=0: %#v", stats.Done, stats.Total, stats.Skipped, stats.Local, stats)
+	}
+
+	// foo.o depends on gen.h only through the deps log.
+	fooObj := outdir + "/obj/foo.o"
+	barObj := outdir + "/obj/bar.o"
+	fooMtime := mtime(t, fooObj)
+	barMtime := mtime(t, barObj)
+	touchFile(t, dir, "base/gen.h.in")
+	t.Logf("-- second build")
+	stats, err = runNinjaTest(t)
+	if err != nil {
+		t.Fatalf("ninja err: %v", err)
+	}
+	if stats.Done != stats.Total || stats.Local != 2 || stats.Skipped != 2 || stats.Total != 4 {
+		t.Errorf("done=%d total=%d skipped=%d local=%d; want done=total=4 skipped=2 local=2: %#v", stats.Done, stats.Total, stats.Skipped, stats.Local, stats)
+	}
+	if got := mtime(t, fooObj); got.Equal(fooMtime) {
+		t.Errorf("%s not rebuilt: mtime=%v", fooObj, got)
+	}
+	if got := mtime(t, barObj); !got.Equal(barMtime) {
+		t.Errorf("%s rebuilt: mtime=%v want=%v", barObj, got, barMtime)
+	}
+}
